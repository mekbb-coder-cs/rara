# Environment Mode
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Security & Secrets
JWT_ACCESS_SECRET=development_jwt_access_secret_super_secure_key_32_bytes_long!
JWT_REFRESH_SECRET=development_jwt_refresh_secret_super_secure_key_32_bytes_long!
ANONYMOUS_TOKEN_SECRET=development_anonymous_secret_key_32_bytes_long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ANONYMOUS_TOKEN_EXPIRES_IN=24h

# Database & Cache
DATABASE_URL=postgresql://relieflink:relieflink_secret@localhost:5432/relieflink?schema=public
REDIS_URL=redis://localhost:6379

# Client & CORS
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=info
