{
  "name": "relieflink",
  "version": "1.0.0",
  "private": true,
  "description": "Crisis-response portal and humanitarian aid-matching platform",
  "scripts": {
    "build": "pnpm --filter ./packages/* --filter ./apps/* run build",
    "test": "pnpm --filter @relieflink/api run test",
    "lint": "pnpm --filter ./packages/* --filter ./apps/* run lint",
    "dev:api": "pnpm --filter @relieflink/api run dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "prettier": "^3.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
